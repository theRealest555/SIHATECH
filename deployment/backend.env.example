# Same-origin HTTPS staging template. Replace staging.example.invalid everywhere.
# This is a template, not an active or deployable configuration.
APP_NAME=SihaTech
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=https://staging.example.invalid
FRONTEND_URL=https://staging.example.invalid
APP_TIMEZONE=UTC
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
CACHE_PREFIX=sihatech_staging_
QUEUE_CONNECTION=database
OPS_REQUIRE_HEARTBEATS=true
APPOINTMENT_REMINDERS_ENABLED=false
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Host-only session cookies; change only for a reviewed subdomain arrangement.
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=staging.example.invalid
CORS_ALLOWED_ORIGINS=https://staging.example.invalid

# Private storage must survive deployments and be shared with workers.
FILESYSTEM_DISK=local
# DOCUMENTS_ROOT=/persistent/sihatech/private

# Keep disabled until real OAuth credentials and exact callbacks are registered.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.example.invalid/api/auth/social/google/callback
FACEBOOK_LOGIN_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://staging.example.invalid/api/auth/social/facebook/callback

# Stripe test-mode credentials only. The signing secret belongs to this endpoint.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

# Obtain these settings from your outbound email provider.
MAIL_MAILER=smtp
MAIL_URL=
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SihaTech
